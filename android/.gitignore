# ===== Node =====
node_modules/
npm-debug.log*
yarn-error.log*

# ===== Capacitor =====
.capacitor/

# ===== Android / Gradle (generated) =====
# Cả dự án native do `npx cap add android` sinh lại mỗi lần build — hơn 100 MB
# và không có gì của riêng kho này (phần riêng nằm ở native/ và patch-android.js).
# Neo bằng dấu / đầu dòng: chỉ chặn đúng android/android/, không chặn nhầm một
# thư mục tên "android" nằm sâu bên trong.
/android/

# Mấy dòng dưới đây giờ đã nằm trong phạm vi dòng trên, nhưng giữ lại: chúng
# ghi ra thứ gì là do máy sinh: bỏ đi thì lỡ sau này ai gỡ dòng `/android/` là
# mất cả hai hàng rào cùng một lúc.
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/build/
android/local.properties
android/.idea/
android/*.iml
android/captures/
android/.externalNativeBuild/
android/.cxx/

# Capacitor copies www into here on sync
android/app/src/main/assets/public/

# Capacitor tự sinh mỗi lần "cap sync" — đường dẫn node_modules theo máy, không commit
android/capacitor.settings.gradle
android/app/capacitor.build.gradle

# ===== Signing / secrets (NEVER commit) =====
*.keystore
*.jks
keystore.properties
google-services.json
*.env
.env*

# ===== OS / Editor =====
.DS_Store
Thumbs.db
.vscode/
.idea/
*.zip
